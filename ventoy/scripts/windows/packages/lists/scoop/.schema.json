{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scoop apps list",
  "type": "object",
  "properties": {
    "$schema": true,
    "level": {
      "type": "string",
      "enum": ["global", "local"],
      "default": "local"
    },
    "bucket": {
      "type": "string",
      "examples": ["main", "extras", "versions", "nerd-fonts"],
      "default": "main"
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "string",
        "examples": ["7zip", "git"]
      },
      "minItems": 1
    }
  },
  "required": ["apps"],
  "additionalProperties": false
}
