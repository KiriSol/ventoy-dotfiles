{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Winget packages configuration",
  "type": "object",
  "properties": {
    "$schema": true,
    "scope": {
      "type": "string",
      "enum": ["user", "machine", "none"],
      "default": "none"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "examples": ["7zip.7zip", "Git.Git"]
          },
          "override": {
            "type": "string",
            "examples": ["/qb", "/quiet", "/passive", "/install /quiet"]
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["scope", "packages"],
  "additionalProperties": false
}
